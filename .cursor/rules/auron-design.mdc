### Gráfico de linha (sempre renderizado)
```tsx
// Regra: renderizar com qualquer quantidade de pontos (0, 1, N)
// Com 0 pontos: linha base horizontal #1e1e1e
// Com 1 ponto: circle isolado
// Com 2+: polyline #2b7fff opacity 0.5

<View style={{ backgroundColor: '#0f0f0f', borderRadius: 10, padding: 10 }}>
  <Svg>
    <Line x1={0} y1={height-2} x2={width} y2={height-2} stroke="#1e1e1e" strokeWidth={0.5} />
    {data.length >= 2 && (
      <Polyline
        points={computedPoints}
        fill="none"
        stroke="#2b7fff"
        strokeWidth={1.5}
        opacity={0.5}
      />
    )}
    {data.length >= 1 && (
      <Circle cx={lastX} cy={lastY} r={3} fill="#2b7fff" opacity={0.7} />
    )}
  </Svg>
</View>
```

