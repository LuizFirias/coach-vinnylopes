## Dados e Formatação

```ts
// Volume sempre em kg (NÃO toneladas)
// 5900 → "5.900 kg"
formatVolume(kg: number): string {
  return `${kg.toLocaleString('pt-BR')} kg`
}

// Tempo de descanso
// 60 → "1min" | 90 → "1:30" | 30 → "30s"
formatRestTime(seconds: number): string {
  if (seconds < 60) return `${seconds}s`
  const m = Math.floor(seconds / 60)
  const s = seconds % 60
  return s === 0 ? `${m}min` : `${m}:${String(s).padStart(2, '0')}`
}

// Delta de peso
// negativo = verde (queda de peso = bom)
// positivo = vermelho (ganho = ruim, depende do contexto)
deltaColor = delta < 0 ? '#39c75a' : '#e05555'

// Tabela Supabase de exercícios: exercicios_biblioteca (NÃO exercises)
// Séries: fichas_treino.configuracao (JSONB)
// Peso prescrito: campo peso / peso_sugerido no JSON
```

